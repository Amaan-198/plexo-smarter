{
  "manifest_version": 3,
  "name": "Plexo",
  "short_name": "Plexo",
  "version": "1.0.0",
  "description": "Hands downloads to the Plexo app, which fetches them over every network at once.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Plexo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "cookies", "storage", "contextMenus", "scripting", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "*://filekeeper.net/*", "*://*.filekeeper.net/*"],
  "optional_host_permissions": ["*://*/*"]
}
